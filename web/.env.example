# Base URL of the QCaaS FastAPI backend (no trailing slash).
# Local dev: http://localhost:8000
# Vercel preview: staging API URL; Vercel production: production API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL of the Go "accounts" service (login/register, API-key provisioning, authenticated /proxy/v2/*).
# Local dev: http://localhost:8080
# Vercel preview: staging accounts URL; Vercel production: production accounts URL.
NEXT_PUBLIC_ACCOUNTS_URL=http://localhost:8080
