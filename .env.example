# Copy to .env for local development. All variables are prefixed QCAAS_.
QCAAS_ENVIRONMENT=dev
QCAAS_LOG_LEVEL=INFO

# Storage (SQLite for MVP; use postgresql+psycopg://... in production)
QCAAS_DATABASE_URL=sqlite:///./data/qcaas.db
QCAAS_RETENTION_DAYS_DEFAULT=30

# Security
QCAAS_API_KEY_SALT=change-me-in-production
QCAAS_DEV_API_KEY=dev-key-change-me          # dev/staging only; unset in production
QCAAS_CORS_ORIGINS=["http://localhost:3000"]
QCAAS_RATE_LIMIT_PER_MINUTE=60

# IBM Quantum (leave unset to use fake backends offline)
QCAAS_OFFLINE_MODE=true
QCAAS_IBM_TOKEN=
QCAAS_IBM_INSTANCE=
QCAAS_IBM_CHANNEL=ibm_quantum_platform
QCAAS_DEFAULT_BACKEND=ibm_sherbrooke
QCAAS_ALLOW_QPU_EXECUTION=false             # Phase 8 master switch; costs real money when true

# Classiq (SDK reads these directly; machine-to-machine credentials)
QCAAS_CLASSIQ_ENABLED=true
CLASSIQ_CLIENT_ID=
CLASSIQ_CLIENT_SECRET=
CLASSIQ_ORG_ID=

# Router
QCAAS_FALLBACK_TIMEOUT_SEC=30
QCAAS_REQUEST_TIMEOUT_SEC=120
