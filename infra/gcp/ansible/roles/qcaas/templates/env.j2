# Managed by Ansible - do not edit on the host.
API_IMAGE={{ api_image }}
ACCOUNTS_IMAGE={{ accounts_image }}
DOMAIN={{ domain }}
ACME_EMAIL={{ acme_email }}

# Neon Postgres
QCAAS_DATABASE_URL={{ qcaas_database_url }}
ACCOUNTS_DB_URL={{ accounts_db_url }}

# Secrets
QCAAS_ADMIN_TOKEN={{ qcaas_admin_token }}
QCAAS_API_KEY_SALT={{ qcaas_api_key_salt }}
ACCOUNTS_JWT_SECRET={{ accounts_jwt_secret }}
ACCOUNTS_ENCRYPTION_KEY={{ accounts_encryption_key }}
ACCOUNTS_ADMIN_EMAILS={{ accounts_admin_emails }}

# CORS (Vercel web app)
QCAAS_CORS_ORIGINS={{ web_origins | to_json }}
ACCOUNTS_CORS_ORIGINS={{ web_origins | join(',') }}

# Quantum providers
QCAAS_OFFLINE_MODE={{ qcaas_offline_mode }}
QCAAS_IBM_TOKEN={{ qcaas_ibm_token }}
QCAAS_IBM_INSTANCE={{ qcaas_ibm_instance }}
CLASSIQ_CLIENT_ID={{ classiq_client_id }}
CLASSIQ_CLIENT_SECRET={{ classiq_client_secret }}
